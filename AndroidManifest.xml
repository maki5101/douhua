<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.douhua">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 只用来连本机 127.0.0.1 上的豆花服务，不上网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 接上外接显示器时弹"点这里把手机当触控板"的通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 蓝牙模式：手机当蓝牙键盘鼠标（连已配对的设备）；配对新设备时让别的设备搜到这台手机 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- 手机自己拉起服务（无线调试连本机 adbd）：设置页看连没连 Wi-Fi（不读网络名，不要位置权限） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 配对时的前台服务（shortService 不用别的类型权限），通知里输入配对码 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 开机后连上 Wi-Fi 自动启动服务（设置里"自动启动服务"开着才做） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 第一次经无线调试 adb（shell）连上后 pm grant 授予（保护级别含 development，普通安装不会自动获得），
         之后豆花自己开关无线调试。不在清单里申请，pm grant 会报"has not requested permission" -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- 空中鼠标"回正中"校准；转屏不重建，免得打断正在走的光标 -->

        <!-- 只有豆花服务（shell 身份，有 DUMP 权限）能触发 -->
        <receiver
            android:name=".DisplayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".SelfTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- 无线调试配对：通知里输入配对码。几分钟内做完的事，用 shortService（见 PairingService 类注释） -->
        <service
            android:name=".PairingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- 开机广播只有系统发得出来；收到后只排一个等 Wi-Fi 的任务 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 开机后等 Wi-Fi 再自动启动服务（JobScheduler 调起） -->
        <service
            android:name=".SelfStartJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
