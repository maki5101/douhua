<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.douhua">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 只用来连本机 127.0.0.1 上的豆花服务，不上网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 接上外接显示器时弹"点这里把手机当触控板"的通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- 只有豆花服务（shell 身份，有 DUMP 权限）能触发 -->
        <receiver
            android:name=".DisplayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".SelfTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
