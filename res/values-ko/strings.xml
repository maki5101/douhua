    <string name="act_air_drag">눌러서 드래그 (누르는 동안 왼쪽 버튼 누름, 커서가 따라감; 블루투스 모드 전용)</string>
    <string name="act_air_drag_s">눌러서 드래그</string>
    <string name="act_air_center">가운데로 (커서를 한 번에 화면 가운데로)</string>
    <string name="act_air_center_s">가운데로</string>
    <string name="air_bt_only">에어 마우스는 블루투스 모드에서만 쓸 수 있습니다</string>
    <string name="air_no_gyro">이 폰에는 자이로스코프가 없어 에어 마우스를 쓸 수 없습니다</string>
    <string name="air_following">따라가는 중</string>
    <string name="air_dragging">드래그 중 (왼쪽 버튼 누름)</string>
    <string name="air_waiting">블루투스 연결 안 됨</string>
    <string name="air_exit">길게 눌러 에어 마우스 종료</string>
    <string name="sec_air">에어 마우스</string>
    <string name="air_sensitivity">에어 마우스 감도 (같은 각도로 돌릴 때 커서가 움직이는 거리)</string>
    <string name="air_space">방향 환산: 휴대폰 회전을 좌우·상하로 어떻게 나눌지</string>
    <string name="air_space_player">플레이어 공간(기본): 상하 = 휴대폰 자체 끄덕임, 좌우 = 수직축 회전(GyroWiki / JoyShockMapper)</string>
    <string name="air_space_oblique">사교 기저: 좌우 = 수직축 회전, 상하 = 휴대폰 자체 끄덕임(기울여 잡은 영향 제거)</string>
    <string name="air_space_world">월드 공간: 좌우 = 수직축 회전, 상하 = 수평축 끄덕임</string>
    <string name="air_min_cutoff">떨림 보정: 정지 시 차단 주파수(낮을수록 안정적이지만 더 느림)</string>
    <string name="air_beta">떨림 보정: 빠르게 움직일 때 따라가는 정도 β(클수록 잘 따라가지만 더 흔들림)</string>
    <string name="air_speed_cutoff">떨림 보정: \"움직임\"을 판단하는 속도(낮을수록 손떨림을 움직임으로 덜 오인하지만 출발이 느림)</string>
    <string name="air_deadzone">소프트 데드존: 이보다 느린 움직임은 비례 축소(클수록 멈췄을 때 안정적, 미세 조정은 어려움)</string>
    <string name="air_path">궤적 다듬기: 진행 방향은 그대로, 옆으로 흔들리는 부분만 부드럽게(클수록 곧고 매끄럽지만 모서리가 둥글어짐; 0 = 끔)</string>
    <string name="air_string">떨림 방지 반경: 이 각도 안의 손 흔들림에는 포인터가 움직이지 않음(클수록 멈췄을 때 안정적, 되돌아갈 때 조금 더 돌려야 함; 0 = 끔)</string>
    <string name="air_filter_reset">떨림 보정 기본값으로</string>
    <string name="air_abs_note">가운데로는 화면 가운데로 바로 이동합니다 (절대 좌표). 이 버전 전에 페어링한 기기는 그 기기의 블루투스 설정에서 이 폰을 삭제하고 한 번 다시 페어링하세요.</string>
    <string name="air_aspect">%1$s 화면 비율(에어 마우스 화면에서 위아래 속도가 이것으로 정해짐. 틀리면 위아래가 좌우보다 빠르거나 느리게 느껴짐)</string>
    <string name="air_aspect_auto">자동(Apple은 4:3, 나머지는 16:9)</string>
    <string name="air_fix_v">세로선 각도 보정(세로선 위쪽이 오른쪽으로 기울면 + 쪽으로)</string>
    <string name="air_fix_h">가로선 각도 보정(가로선 오른쪽이 내려가면 + 쪽으로)</string>
    <string name="air_aspect_custom">또는 해상도를 입력(너비 × 높이):</string>
    <string name="air_buttons">에어 마우스 화면 버튼 (위에서 아래로, 한 줄에 두 개; 가운데 둥근 버튼은 고정: 누르는 동안 이동, 탭하면 이동 고정, 다시 탭하면 해제)</string>
    <string name="air_row_add">＋ 줄 추가 (최대 %1$d줄)</string>
    <string name="air_round_at">둥근 버튼 위치</string>
    <string name="air_round_between">%1$d, %2$d, %3$d, %4$d 사이</string>
    <string name="sec_hard_keys">볼륨 키</string>
    <string name="hard_keys_hint">\'없음\'이면 가로채지 않고 평소처럼 볼륨 조절. 동작을 지정한 키는 모두 더우화가 받아서 볼륨이 바뀌지 않습니다. \'눌러서 이동\'을 \'탭\'에 두면 탭으로 시작, 다시 탭하면 멈춤.</string>
    <string name="hk_up_tap">볼륨 + 탭</string>
    <string name="hk_up_hold">볼륨 + 길게</string>
    <string name="hk_down_tap">볼륨 − 탭</string>
    <string name="hk_down_hold">볼륨 − 길게</string>
    <string name="hard_keys_service_hint">DeX 모드에서는 더우화 서비스가 실행 중이어야 합니다. 통화 중이거나 전화가 울릴 때는 가로채지 않습니다. 전원 키와 같은 장치에 있는 볼륨 키는 서비스가 가로채지 않으므로, 볼륨 다운 키가 그런 휴대폰에서는 DeX 모드에서 볼륨 업에만 동작을 지정할 수 있습니다.</string>
    <string name="hard_keys_unavailable">이 휴대폰에서는 %1$s을(를) 따로 가로챌 수 없어(이유는 서비스 로그 / Server keys 참고) 지정한 동작이 작동하지 않습니다</string>
    <string name="hard_keys_no_injector">서비스가 키를 주입할 수 없어 볼륨 키를 가로채지 않습니다(볼륨 키가 작동하지 않게 되므로)</string>
    <string name="hard_keys_no_device">이 휴대폰에서 %1$s에 해당하는 입력 장치를 찾지 못해 지정한 동작이 작동하지 않습니다</string>
    <string name="hard_keys_failed">%1$s을(를) 가로채다가 오류가 나서 지정한 동작이 작동하지 않습니다: %2$s</string>
    <string name="hard_keys_mixed">%1$s을(를) 가로챌 수 없어 지정한 동작이 작동하지 않습니다: %2$s</string>
    <string name="key_name_volume_up">볼륨 업 키</string>
    <string name="key_name_volume_down">볼륨 다운 키</string>
    <string name="air_center_btn">가운데로</string>
    <!-- 豆花儿服务：手机自己拉起服务（设置页那一节、配对通知、结果） -->
    <string name="sec_service">더우화 서비스</string>
    <string name="svc_intro">서비스는 터치스크린을 독점하고 가상 마우스와 키보드를 만듭니다(DeX 모드에서 필수, 블루투스 모드에서는 시스템 제스처도 막아 줌). shell 권한으로 실행해야 합니다. 더우화는 \'무선 디버깅\'으로 컴퓨터 없이 직접 서비스를 시작할 수 있습니다. 아래 항목을 모두 체크 상태로 만드세요.</string>
    <string name="svc_wifi">Wi-Fi</string>
    <string name="svc_wifi_on">연결됨</string>
    <string name="svc_wifi_off">연결 안 됨</string>
    <string name="svc_wifi_hint">무선 디버깅은 휴대폰이 Wi-Fi에 연결된 동안에만 됩니다(모바일 데이터만 쓰거나 휴대폰 자체 핫스팟으로는 안 됨). 인터넷은 필요 없고 공유기에 연결되어 있으면 됩니다.</string>
    <string name="svc_wifi_btn">Wi-Fi 설정 열기</string>
    <string name="svc_dev">개발자 옵션</string>
    <string name="svc_on">켜짐</string>
    <string name="svc_off">꺼짐</string>
    <string name="svc_dev_hint">삼성: 설정 → 휴대전화 정보 → 소프트웨어 정보 → \'빌드번호\'를 7번 탭. 다른 휴대폰 대부분: 휴대전화 정보 → \'빌드 번호\'를 7번 탭.</string>
    <string name="svc_dev_btn">\'휴대전화 정보\' 열기</string>
    <string name="svc_usb">USB 디버깅</string>
    <string name="svc_usb_hint">개발자 옵션에서 \'USB 디버깅\'을 켜세요. 케이블은 필요 없지만 서비스는 이것에 기대어 동작합니다: 끄면 서비스가 멈춥니다.</string>
    <string name="svc_usb_need_dev">먼저 위의 개발자 옵션을 켜세요.</string>
    <string name="svc_usb_btn">개발자 옵션 열기</string>
    <string name="svc_wireless">무선 디버깅</string>
    <string name="svc_wireless_on">켜짐</string>
    <string name="svc_wireless_off">꺼짐</string>
    <string name="svc_wireless_auto">꺼져 있어도 됩니다: 서비스를 시작할 때 더우화가 직접 켜고 시작 후 바로 다시 끕니다(직접 켠 경우는 건드리지 않음).</string>
    <string name="svc_wireless_manual">서비스를 시작하기 전에 개발자 옵션에서 켜세요. 어떤 Wi-Fi에서 처음 켜면 시스템이 물어봅니다. 집 등 믿을 수 있는 Wi-Fi라면 \'이 네트워크에서 항상 허용\'을 고르고, 공용 네트워크에서는 고르지 마세요. 한 번 시작에 성공하면 그다음부터는 더우화가 직접 켜고 끌 수 있습니다.</string>
    <string name="svc_wireless_left_on">무선 디버깅이 켜져 있습니다: 같은 네트워크의 기기에서 보입니다. 컴퓨터로 휴대폰에 연결하지 않을 때는 끄는 것이 좋고, 공용 네트워크에서는 특히 그렇습니다. 서비스가 실행된 뒤에는 꺼도 서비스가 멈추지 않습니다(USB 디버깅이 켜져 있으면).</string>
    <string name="svc_wireless_btn">무선 디버깅 열기</string>
    <string name="svc_wireless_close_btn">열어서 끄기</string>
    <string name="svc_pair">페어링</string>
    <string name="svc_paired">페어링됨</string>
    <string name="svc_not_paired">페어링 안 됨</string>
    <string name="svc_key_rejected">다시 페어링 필요</string>
    <string name="svc_pair_hint">한 번만 하면 됩니다(더우화를 다시 설치하면 다시 필요). 순서는 아래에 있습니다.</string>
    <string name="svc_pair_need_above">먼저 위의 Wi-Fi, 개발자 옵션, USB 디버깅을 모두 체크 상태로 만드세요.</string>
    <string name="svc_key_rejected_hint">시스템이 더우화의 키를 무효로 했습니다(7일 동안 쓰지 않으면 자동으로 무효가 되고, USB 디버깅 권한을 취소해도 지워짐). 한 번 더 페어링하세요.</string>
    <string name="svc_pair_btn">페어링 시작</string>
    <string name="svc_repair_btn">다시 페어링</string>
    <string name="svc_pair_cancel_btn">페어링 취소</string>
    <string name="svc_pairing_now">페어링 중…</string>
    <string name="svc_pairing_now_hint">아래 순서대로 하고, 코드는 더우화 알림에 입력하세요. 알림이 사라졌다면 \'페어링 취소\'를 누르고 다시 시작하세요.</string>
    <string name="svc_notif_off">더우화 알림이 꺼져 있습니다. 페어링 코드는 더우화 알림에 입력하므로 먼저 알림을 허용하세요(여기를 탭).</string>
    <string name="svc_guide_title">페어링 방법</string>
    <string name="svc_guide_1">1. 개발자 옵션과 USB 디버깅을 켭니다(위 참고).</string>
    <string name="svc_guide_2">2. 위의 \'페어링 시작\'을 탭: 더우화가 알림을 띄우고 개발자 옵션을 엽니다.</string>
    <string name="svc_guide_3">3. \'무선 디버깅\'을 켜고(이 Wi-Fi에서 처음이면 시스템이 물어봅니다. \'항상 허용\'은 집 등 믿을 수 있는 Wi-Fi에서만 고르세요. 아래 참고), 눌러서 들어간 뒤 \'페어링 코드로 기기 페어링\'을 탭합니다.</string>
    <string name="svc_guide_4">4. 시스템이 6자리 코드를 보여 주면 화면 위쪽에서 알림창을 끌어내리고, 더우화 알림에서 \'페어링 코드 입력\'을 탭해 입력하고 보내세요. 시스템의 페어링 창을 벗어나지 마세요: 벗어나는 즉시 닫힙니다.</string>
    <string name="svc_guide_5">5. 페어링에 성공하면 더우화가 직접 서비스를 시작하고, 결과는 알림에 나옵니다.</string>
    <string name="svc_public_wifi">\'항상 허용\'은 집 등 믿을 수 있는 Wi-Fi에서만 고르고, 카페·회사·호텔 같은 공용 네트워크에서는 고르지 마세요. 고른 네트워크에서는 앞으로 더우화가 서비스를 시작할 때마다 무선 디버깅을 몇 초 켜고, 그동안 같은 네트워크의 기기에서 켜져 있는 것이 보입니다. 연결하려면 페어링된 키나 페어링 코드가 필요하지만, 이 확인을 우회할 수 있는 취약점(CVE-2026-0073)이 2026년 5월에야 고쳐졌으니 공용 네트워크에서는 고르지 마세요.</string>
    <string name="svc_service">서비스</string>
    <string name="svc_running">실행 중</string>
    <string name="svc_not_running">실행 안 됨</string>
    <string name="svc_old_version">버전 불일치(서비스 %1$d, 앱 %2$d)</string>
    <string name="svc_stuck">응답 없음</string>
    <string name="svc_checking">확인 중…</string>
    <string name="svc_starting">시작 중…</string>
    <string name="svc_start_hint">위 항목이 모두 체크되면 아래를 탭하세요.</string>
    <string name="svc_need_pair">먼저 페어링하세요(위 참고).</string>
    <string name="svc_start_btn">서비스 시작</string>
    <string name="svc_restart_btn">서비스 재시작</string>
    <string name="svc_last_result">지난번 시작 실패: %1$s</string>
    <string name="svc_warn_untrusted">시스템이 무선 디버깅을 다시 껐습니다. 아마 이 Wi-Fi가 아직 신뢰되지 않았기 때문입니다. 집 등 믿을 수 있는 Wi-Fi라면 무선 디버깅을 열고 이 네트워크에서 \'항상 허용\'을 고르세요(여기를 탭). 공용 네트워크에서는 고르지 마세요(아래 참고). 3분 안에 허용하면 더우화가 이어서 서비스를 시작합니다.</string>
    <string name="svc_auto">서비스 자동 시작</string>
    <string name="svc_auto_hint">더우화를 열었을 때 서비스가 실행 중이 아니면(또는 더우화를 막 업데이트했으면) 시작합니다. 휴대폰을 다시 켠 뒤에도 Wi-Fi에 연결되면 시작합니다. 페어링에 성공하면 자동으로 켜집니다.</string>
    <string name="svc_auto_paused">자동 시작이 일시 중지됨: 시스템이 \'이 네트워크에서 무선 디버깅을 허용할까요?\'라고 물었을 때 허용되지 않았습니다(공용 네트워크일 수 있음). 더우화는 어느 Wi-Fi에 연결됐는지 알 수 없어서, 여기저기서 확인 창이 뜨지 않도록 무선 디버깅을 직접 켜지 않습니다. 무선 디버깅이 원래 켜져 있으면 자동 시작은 그대로 됩니다. 위의 \'서비스 시작\'(실행 중이면 \'서비스 재시작\')이 한 번 성공하면 다시 켜집니다.</string>
    <string name="svc_warn_usb">주의: USB 디버깅이나 개발자 옵션을 끄면 서비스가 바로 멈춥니다. 삼성의 \'자동 차단\'(설정 → 보안 및 개인정보 보호 → 자동 차단)은 USB 디버깅을 끄므로, 더우화 서비스를 쓰는 동안에는 꺼 두세요.</string>
